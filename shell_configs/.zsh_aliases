# Specify default editor. Possible values: vim, nano, ed etc.
export EDITOR=nvim

# PATHS
# export VERILATOR_ROOT=/home/usmansiddique/Tools/verilator/
export PATH="$HOME/Tools/oss-cad-suite-linux-x64-2026-10-07/bin:$PATH"
export PATH="$HOME/Tools/verible/bin:$PATH"
export PATH="$HOME/.platformio/penv/bin:$PATH"

# source vivado
VIVADO_SETTINGS=/tools/Xilinx/2025.1/Vivado/settings64.sh
[ -f "$VIVADO_SETTINGS" ] && source "$VIVADO_SETTINGS"
# source vitis HLS
VITIS_SETTINGS=/tools/Xilinx/2025.1/Vitis/settings64.sh
[ -f "$VITIS_SETTINGS" ] && source "$VITIS_SETTINGS"

# ====================================================== Aliases
# display fortune quote inside cowsay tux
alias fortune='fortune | cowsay -f tux'

# Teresol gitlab repos clone

# Server ssh

# some more ls aliases
# alias ll='ls -lF'
# alias la='ls -A'
# alias l='ls -CF'

# add color support
# alias grep='grep --color=auto'
# alias fgrep='fgrep --color=auto'
# alias egrep='egrep --color=auto'

# display folders
alias ls='eza -GxF --icons --group-directories-first --color=auto'
alias ll='eza -lhF --icons --group-directories-first --color=auto'

# display tree
alias tree='tree -q --dirsfirst -C --sort name'

# display all mounted drives
alias mnt="mount | awk -F' ' '{ printf \"%s\t%s\n\",\$1,\$3; }' | column -t | egrep ^/dev/ | sort"

# count files in directory
alias count='find . -type f | wc -l'

# copy progress bar: cpy ./source ./destination
alias cpv='rsync -avP --info=progress2'

# give battery status
alias battery='upower -i /org/freedesktop/UPower/devices/battery_BAT0 | grep -E "state|to full|percentage"'

# run flopoco docker container
alias flopoco="docker run --rm=true -v `pwd`:/flopoco_workspace flopoco"

# change dir and view contents simultaneously
function cl() {
    DIR="$*";
        # if no DIR given, go home
        if [ $# -lt 1 ]; then
                DIR=$HOME;
    fi;
    builtin cd "${DIR}" && \
    # use your preferred ls command
        ls
}

